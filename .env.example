# Server Configuration (Optional on Vercel, defaults to 3000/4000 locally)
PORT=4000

# Database Configuration (Set these in Vercel Project Settings -> Environment Variables)
# Option 1: Full Connection URL (Recommended for Vercel)
DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@promotorsdb01-sparavoor.k.aivencloud.com:18515/promotersdatadb?ssl-mode=REQUIRED"

# Option 2: Individual variables (Fallback)
DB_HOST=promotorsdb01-sparavoor.k.aivencloud.com
DB_PORT=18515
DB_USER=avnadmin
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=promotersdatadb
DB_SSL=true

# Admin Authentication (Optional, defaults to graphadmin / graph951)
ADMIN_USERNAME=graphadmin
ADMIN_PASSWORD=graph951
